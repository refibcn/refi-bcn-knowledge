---
// /system — the data layer, depicted from the data itself (DC-3). Four bands:
// FEEDS → STORE → CURATION → SURFACES, each box carrying live counts and
// linking to its surface. Below: the authority table (what is source of truth
// for what) and the gate inventory (what stops content leaking).
// No hand-drawn numbers anywhere — this page cannot rot the way a diagram would.
import Layout from "../components/Layout.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { sourcesViewModel } from "../lib/sources.mjs";
import { collectionsViewModel } from "../lib/collections.mjs";
import { loadKb, publishableKb } from "../lib/kb.mjs";
import { withBase } from "../lib/paths";

const src = sourcesViewModel();
const col = collectionsViewModel();

// Counted live off the in-repo store (kb/), the same read /sources and
// /knowledge perform — so this page cannot disagree with them, which is the
// one thing its own lede promises cannot happen.
const all = loadKb();
const objectsTotal = all.length;
const inReview = all.filter((o) => o.maturity === "raw").length;
const publishedCount = publishableKb(all).length;
const schemaCount = new Set(all.map((o) => o.schema)).size;

const bands = [
  {
    name: "Feeds",
    items: [
      // "Ingested sources", not "Repo sources": one of the four is
      // `notion-refi-bcn`, a Notion extraction rather than a repository, so
      // the old label both misdescribed the set and made the line below read
      // as a fifth feed when it is a different KIND of feed entirely.
      {
        label: "Ingested sources",
        n: src.rows.filter((r) => r.role === "source").length,
        href: "sources/",
      },
      // Distinct from the `notion-refi-bcn` container above: that one holds
      // objects already extracted INTO the store, this is the live read the
      // directory pages perform at build time and never persist.
      {
        label: "Notion CRM (live at build, never stored)",
        n: null,
        href: "organizations/",
      },
    ],
  },
  {
    name: `Store (kb/, ${schemaCount} schemas)`,
    items: [
      // "Objects", not "typed objects": this counts the WHOLE store, source
      // cards included. /slices reserves "typed objects" for the store minus
      // those 6 cards (416), and the two pages link to each other — reusing
      // its term for a different number is how a reader ends up comparing
      // 422 against 416 with nothing to reconcile them.
      { label: "Objects", n: objectsTotal, href: "sources/" },
      { label: "In review (raw)", n: inReview, href: null },
    ],
  },
  {
    name: "Curation",
    items: [
      { label: "Collections", n: col.rows.length, href: "collections/" },
      { label: "Published", n: publishedCount, href: "knowledge/" },
    ],
  },
  {
    name: "Surfaces",
    items: [
      {
        label: "Knowledge · Atlas · Directory · Review",
        n: null,
        href: "knowledge/",
      },
    ],
  },
];

const AUTHORITY = [
  {
    what: "KB objects",
    sot: "kb/ (this repo)",
    note: "One markdown file per object — frontmatter is the fields, the body is the notes. Local files are the source of truth.",
  },
  {
    what: "CRM records",
    sot: "refi-bcn-os data/crm.yaml",
    note: "The CRM registry stays in the refi-bcn-os workspace; Notion is the pushed mirror — the instance reads the mirror, at build time, read-only.",
  },
  {
    what: "Collections",
    sot: "src/data/collections.yaml",
    note: "Hand-authored definitions; membership is computed, not stored.",
  },
  {
    what: "Ingest disposition",
    sot: "src/data/sources-disposition.json",
    note: "Derived from the refi-bcn-os batch rosters and committed — never hand-edited.",
  },
];

const GATES = [
  {
    what: "publishableKb",
    note: "Fail-closed: an object publishes only if it is marked in-scope, cleared to reviewed/published maturity, not AI-assisted, and clears its paired public-use boundary tier.",
  },
  {
    what: "dist canary + listing scan",
    note: "scripts/verify-public-kb.mjs walks the built dist/ tree after every public build, checking for known raw-content canaries; fails the build closed.",
  },
  {
    what: "staticrypt internal lens",
    note: "The internal review build is encrypted before it leaves the machine; a separate gate asserts exactly one HTML file, a staticrypt marker, and no /_astro references.",
  },
  {
    what: "computed archive-ready verdicts",
    note: "A source is archive-ready only when all four checks pass: every file is dispositioned, the batch numbers reconcile against the checkout, every high-risk object (Indigenous/TEK, personal, governance-sensitive material) has cleared raw review, and a real signoff is recorded. Any missing input fails the verdict closed — it must never read ready because it has less information, the bug this module was hardened against.",
  },
];
---

<Layout
  title="System"
  current="system"
  section="Knowledge"
  description="The common layer of this instance, drawn from its own data — feeds, store, curation and surfaces, with live counts and the gates that keep content from leaking."
>
  <SectionBlock
    id="system"
    title="System"
    tissue={true}
    tissueSeed={11}
    intro="Four bands, feeds through surfaces, each carrying counts read live off the store — not drawn by hand, so this page cannot describe a system that no longer exists. The containers themselves, and the ontology each one keeps, are the matrix on the home page."
  >
    <p class="lede">
      This is the common layer under the containers — the pipeline that produces
      every other page on this site: sources feed an object store, curation
      narrows it into collections, and a handful of public surfaces render what
      has cleared review. Every number below comes from the same view-models
      that render
      <a href={withBase("sources/")}>/sources</a>,
      <a href={withBase("collections/")}>/collections</a> and
      <a href={withBase("knowledge/")}>/knowledge</a> — if this page ever disagrees
      with one of those, that is a bug in this page, not in them.
    </p>

    <div class="sys-flow">
      {
        bands.map((band, i) => (
          <>
            <div class="sys-band">
              <h3 class="sys-band__name">{band.name}</h3>
              <dl class="sys-band__items">
                {band.items.map((item) => (
                  <div class="sys-item">
                    <dt>
                      {item.href ? (
                        <a href={withBase(item.href)}>{item.label}</a>
                      ) : (
                        <span>{item.label}</span>
                      )}
                    </dt>
                    <dd class="sys-item__n">
                      {item.n !== null ? item.n : "—"}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
            {i < bands.length - 1 && (
              <div class="sys-connector" aria-hidden="true" />
            )}
          </>
        ))
      }
    </div>

    <p class="sys-reconcile">
      {
        /* Both numbers are derived, never written down: `objectsTotal` is the
          whole store, `src.totals.objects` is exactly what /sources renders.
          The gap between them is stated rather than computed to a literal, so
          this sentence stays true if either side moves. */
      }
      Two counts of the store are in circulation, and they differ by the{" "}
      <strong>{objectsTotal - src.totals.objects}</strong> source cards. The{
        " "
      }
      <strong>{objectsTotal}</strong> above is everything in <code>kb/</code>,
      cards included — a card describes a container rather than belonging to
      one, so <a href={withBase("sources/")}>/sources</a> attributes{" "}
      <strong>{src.totals.objects}</strong> objects to containers, and{" "}
      <a href={withBase("slices/")}>/slices</a> counts that same set as typed objects.
      Neither is wrong; they answer different questions, and this note is here so
      nobody has to guess which.
    </p>

    <h3 class="sys-h3">Authority — what is source of truth for what</h3>
    <p class="sys-note">
      Condensed from <code>docs/governance/SOURCE-OF-TRUTH-MATRIX.md</code> in the
      refi-bcn-os workspace, which is canonical — read it there for the full sync
      protocol and conflict-resolution rules.
    </p>
    <table class="sys-table">
      <thead>
        <tr>
          <th scope="col">What</th>
          <th scope="col">Source of truth</th>
          <th scope="col">Notes</th>
        </tr>
      </thead>
      <tbody>
        {
          AUTHORITY.map((row) => (
            <tr>
              <td>{row.what}</td>
              <td>
                <code>{row.sot}</code>
              </td>
              <td>{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 class="sys-h3">Gates — what stops content leaking</h3>
    <table class="sys-table">
      <thead>
        <tr>
          <th scope="col">Gate</th>
          <th scope="col">What it does</th>
        </tr>
      </thead>
      <tbody>
        {
          GATES.map((row) => (
            <tr>
              <td>{row.what}</td>
              <td>{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="sys-note">
      <a href={withBase("slices/")}>/slices</a> draws crosscuts over this pipeline
      — domains by schema, the review funnel, the high-risk queue, and boundary tiers.
    </p>
  </SectionBlock>
</Layout>

<style>
  .sys-reconcile {
    margin: var(--space-6) 0 var(--space-10);
    max-width: 72ch;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: var(--leading-body);
  }
  .sys-reconcile strong {
    color: var(--text-primary);
  }

  .lede {
    max-width: 60ch;
    color: var(--text-muted);
    line-height: var(--leading-body);
  }
  .sys-flow {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: var(--space-8) 0 var(--space-10);
    max-width: 46ch;
  }
  .sys-band {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 14px 16px;
    background: var(--surface-1);
  }
  .sys-band__name {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .sys-band__items {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .sys-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.9rem;
  }
  .sys-item dt,
  .sys-item dd {
    margin: 0;
    font-weight: normal;
  }
  .sys-item dt a {
    color: var(--text-primary);
  }
  .sys-item__n {
    font-family: var(--serif);
    color: var(--text-primary);
    white-space: nowrap;
  }
  .sys-connector {
    width: 1px;
    height: 22px;
    margin: 0 0 0 20px;
    background: var(--border-default);
  }
  .sys-h3 {
    margin: var(--space-10) 0 var(--space-2);
    font-size: var(--text-md);
  }
  .sys-note {
    margin: 0 0 var(--space-4);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .sys-note code {
    font-size: 0.82rem;
  }
  .sys-table {
    width: 100%;
    max-width: 80ch;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .sys-table th,
  .sys-table td {
    text-align: left;
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }
  .sys-table th {
    font-family: var(--mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .sys-table td:first-child {
    white-space: nowrap;
    color: var(--text-primary);
  }
  .sys-table code {
    font-size: 0.8rem;
  }
</style>
