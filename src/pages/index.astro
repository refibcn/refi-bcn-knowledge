---
// / — the hub home, structured AS the architecture the 2026-08-11 sync stated
// (D11): SEPARATE CONTAINERS, each with its own ontology, being linked through
// a COMMON LAYER that is defined gradually.
//
// The containers are the main elements, so they are the page's first and
// largest object: a matrix with the system's eight layers as rows and one
// column per knowledge space, gates and owners on the foot row. Everything
// shared between them — the typed store, the (undefined) common ontology, the
// publication gate, the flows — comes AFTER, as bands of a layer under
// construction. The store is deliberately no longer the protagonist, and this
// page no longer claims "one vocabulary": that was tabled, not settled.
//
// Honesty contract, unchanged from the rest of the site: every count comes
// from a view-model or the live store read — never a literal; every
// number's denominator is stated in the adjacent prose; conditionals are
// explicit (`> 0`), never bare `{arr.length && …}`.
//
// The instance carries no name here on purpose — BD-2026-060 dropped the
// working name and the container name is unratified.
import Layout from "../components/Layout.astro";
import SectionBlock from "../components/SectionBlock.astro";
import { loadKb, publishableKb } from "../lib/kb.mjs";
import { sourcesViewModel } from "../lib/sources.mjs";
import { collectionsViewModel } from "../lib/collections.mjs";
import { matrixViewModel, LAYERS } from "../lib/matrix.mjs";
import { loopNotes, containerCounts } from "../lib/home-summary.mjs";
import { withBase } from "../lib/paths";

// ── Store counts: read live off the in-repo store, same as /system and
// /knowledge — every build carries kb/ since the md-store migration.
const all = loadKb();
const objectsTotal = all.length;
const inReview = all.filter((o) => o.maturity === "raw").length;
const publishedCount = publishableKb(all).length;

// Per-schema tally for the store band.
const bySchemaTally: Record<string, number> = all.reduce(
  (acc: Record<string, number>, o: any) => {
    acc[o.schema] = (acc[o.schema] ?? 0) + 1;
    return acc;
  },
  {},
);
const bySchema: [string, number][] = Object.entries(bySchemaTally).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const schemaCount = bySchema.length;

// All three view-models read the same in-repo store internally.
const m = matrixViewModel();
const col = collectionsViewModel();
// `src` is still read directly for two things the matrix does not carry: the
// status strip's container count, and the unattributed canary — objects no
// container claimed, which surfaces here only when it FAILS.
const src = sourcesViewModel();

// The loops a column declares — the sync's single most important correction
// was that ingestion and the CRM are a loop, not a fork. A list, not a
// `.find()`: see loopNotes() for why a second one must not vanish.
const loops = loopNotes(m.columns);

// The three container counts, and whether they actually add up. `reconciles`
// is computed rather than assumed — the identity is not structural, and
// home-summary.mjs documents (and tests) the case that breaks it.
const counts = containerCounts({
  columns: m.columns,
  footnote: m.footnote,
  containers: src.totals.containers,
});

const statusStrip = [
  { label: "Objects", n: objectsTotal },
  { label: "In review", n: inReview },
  { label: "Published", n: publishedCount },
  { label: "Sources", n: src.totals.containers },
  { label: "Collections", n: col.rows.length },
];

const surfaces = [
  {
    label: "Knowledge",
    href: withBase("knowledge/"),
    blurb: "The public lens on the store — entries that cleared review.",
  },
  {
    label: "Atlas",
    href: withBase("atlas/"),
    blurb: "Catalunya map — comarques and where the work is happening.",
  },
  {
    label: "Organizations",
    href: withBase("organizations/"),
    blurb: "Actor directory, fed live from the Notion CRM at build time.",
  },
  {
    label: "Programs",
    href: withBase("programs/"),
    blurb: "Programs & initiatives, fed live from the Notion CRM.",
  },
  {
    label: "Events",
    href: withBase("events/"),
    blurb: "Gatherings and assemblies, fed live from the Notion CRM.",
  },
  {
    label: "Priorities",
    href: withBase("priorities/"),
    blurb: "Bioregional priorities and the indicators behind them.",
  },
];

const tools = [
  {
    label: "System",
    href: withBase("system/"),
    note: "the common layer drawn from its own data",
  },
  {
    label: "Slices",
    href: withBase("slices/"),
    note: "crosscuts — domains, funnel, high-risk, tiers",
  },
  {
    label: "Review",
    href: withBase("review/"),
    note: "the working set — password-gated",
  },
];
---

<Layout title="Home" current="home">
  <header class="home-intro">
    <p class="eyebrow">Knowledge base</p>
    <h1 class="display">A shared knowledge base for ReFi Barcelona.</h1>
    <p class="lede">
      Separate containers — each with its own ontology — being collected and
      linked through a common layer that is defined gradually. This page is that
      system: every container, every layer, every gate.
    </p>
    <p class="home-note">
      Internal working surface of the knowledge base — public entries appear as
      review promotes them.
    </p>
    <dl class="home-strip">
      {
        statusStrip.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.n}</dd>
          </div>
        ))
      }
    </dl>
  </header>

  <!-- ── the containers: layers × containers ─────────────────────────── -->
  <SectionBlock
    id="containers"
    title="The containers"
    tissue={true}
    tissueSeed={5}
    intro="Every knowledge space is one column; the system's layers are the rows. Some values are computed from the store at every build and the rest are asserted by hand — the note under the table dates the asserted ones. Where a container is blocked, the foot row names the gate and who owns it."
  >
    {
      /* tabindex + role: an overflow-x container is only scrollable by mouse
        or touch unless it can take focus, which strands keyboard-only and
        switch users on a table wider than any viewport (WCAG 2.1.1). */
    }
    <div
      class="home-matrix-scroll"
      tabindex="0"
      role="region"
      aria-label="Containers by layer — scrollable table"
    >
      <table class="home-matrix">
        <caption class="home-matrix__caption">
          Each knowledge space as a column and each layer of the system as a
          row; the foot row carries the gate blocking a container and who owns
          it.
        </caption>
        <thead>
          <tr>
            <th scope="col" class="home-matrix__corner">layer</th>
            {
              m.columns.map((c) => (
                <th
                  scope="col"
                  class:list={[
                    "home-matrix__col",
                    { "home-matrix__col--planned": c.planned },
                  ]}
                >
                  <span class="home-matrix__name">
                    {c.href !== null ? (
                      <a href={withBase(c.href)}>{c.label}</a>
                    ) : (
                      c.label
                    )}
                    {c.planned && (
                      <span class="home-chip home-chip--planned">planned</span>
                    )}
                  </span>
                  {c.steward !== null && (
                    <span class="home-matrix__steward">{c.steward}</span>
                  )}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            LAYERS.map((layer) => (
              <tr>
                <th scope="row" class="home-matrix__layer">
                  {layer.label}
                </th>
                {m.columns.map((c) => {
                  const cell = c.cells[layer.id];
                  return (
                    <td
                      class:list={[
                        "home-matrix__td",
                        { "home-matrix__td--planned": c.planned },
                      ]}
                    >
                      {/* Three shapes live in this one slot, and each is a
                          separate hazard: an `external` href must NOT go
                          through withBase() (it would emit "/https://…");
                          an ingestion cell is the only shape whose `text` can
                          be null, and only on a column with no defs entry
                          (matrix.mjs:237) — no current column is one, so that
                          guard is unexercised in output, not unnecessary;
                          `detail` and `ref` are independent, and neither
                          implies the other.
                          `== null`, not `===`: a LAYERS id the builders never
                          emit arrives as `undefined`, which strict equality
                          would send to the else branch to throw on
                          `cell.text`. */}
                      {cell == null ? (
                        <span class="home-matrix__none">—</span>
                      ) : (
                        <>
                          {cell.text &&
                            (cell.href ? (
                              cell.external ? (
                                <a
                                  href={cell.href}
                                  target="_blank"
                                  rel="noopener"
                                >
                                  {cell.text}
                                </a>
                              ) : (
                                <a href={withBase(cell.href)}>{cell.text}</a>
                              )
                            ) : (
                              cell.text
                            ))}
                          {cell.detail && (
                            <span class="home-matrix__detail">
                              {cell.detail}
                            </span>
                          )}
                          {cell.ref && (
                            <span class="home-matrix__detail">{cell.ref}</span>
                          )}
                        </>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" class="home-matrix__layer">Gate</th>
            {
              m.columns.map((c) => (
                <td
                  class:list={[
                    "home-matrix__td",
                    { "home-matrix__td--planned": c.planned },
                  ]}
                >
                  {c.gate !== null ? (
                    <>
                      <span class="home-matrix__gate">{c.gate}</span>
                      {c.owner !== null && (
                        <span class="home-matrix__owner">→ {c.owner}</span>
                      )}
                    </>
                  ) : (
                    <span class="home-matrix__none">—</span>
                  )}
                </td>
              ))
            }
          </tr>
        </tfoot>
      </table>
    </div>

    <p class="home-sum">
      {
        loops.map((l) => (
          <>
            <strong>{l}</strong>{" "}
          </>
        ))
      }
      Asserted values as of {m.asOf}; computed values are read from the store at
      every build.
      {
        m.footnote.length > 0 && (
          <>
            {" "}
            Not shown as containers:{" "}
            {m.footnote.map((f, i) => (
              <>
                {i > 0 && " · "}
                <a href={withBase(f.href)}>{f.title}</a>
              </>
            ))}{" "}
            — infrastructure around the consolidation, not knowledge spaces.{" "}
            <a href={withBase("sources/")}>/sources</a> lists every container.
          </>
        )
      }
      {
        /* Editing this paragraph? Every conditional branch must START with a
          word, never punctuation: the compiler emits a space at each branch
          boundary, so a branch beginning "," renders "cards ,". Carry the
          clause's terminal punctuation INSIDE the branch, attached to its
          last word. Same reason system.astro:194 puts a space before its
          text after every <strong>. */
      }
      {
        /* Stated only when the arithmetic holds — see home-summary.mjs. */
        counts.reconciles && counts.carded > 0 && (
          <>
            {" "}
            Counting up: the matrix holds <strong>{counts.carded}</strong>{" "}
            containers with source cards
            {counts.planned > 0 ? (
              <>
                {" "}
                and <strong>{counts.planned}</strong> planned ones that carry no
                card and so appear in no count.{" "}
              </>
            ) : (
              <> and no planned ones yet. </>
            )}
            The Sources figure at the top of this page counts{" "}
            <strong>{counts.containers}</strong> — those same {counts.carded}{" "}
            carded containers
            {counts.infrastructure > 0 ? (
              <>
                {" "}
                plus the {counts.infrastructure} infrastructure ones named just
                above.
              </>
            ) : (
              <> alone.</>
            )}
          </>
        )
      }
      {
        /* The fault path: a matrix column naming a non-source container is
          rendered as a column AND listed in the footnote, so the sum above
          would be a confident lie. Surface the break instead, like the
          unattributed canary. */
        counts.reconciles === false && (
          <strong>
            {" "}
            ⚠ these container counts do not reconcile: the matrix holds{" "}
            {counts.carded} carded containers and the footnote lists{" "}
            {counts.infrastructure} infrastructure ones, but{" "}
            <a href={withBase("sources/")}>/sources</a> counts{" "}
            {counts.containers} — a container is being claimed twice or not at
            all.
          </strong>
        )
      }
      {
        src.totals.unattributed > 0 && (
          <strong>
            {" "}
            ⚠ {src.totals.unattributed} objects match no container — that is a
            fault; see <a href={withBase("sources/")}>/sources</a>.
          </strong>
        )
      }
    </p>
  </SectionBlock>

  <!-- ── the common layer, band by band ──────────────────────────────── -->
  <section class="home-bands" aria-labelledby="common-layer">
    <div class="home-bands__inner">
      <div class="home-bands__head">
        <h2 id="common-layer">The common layer — defined gradually</h2>
        <p class="home-bands__intro">
          What the containers share is being built one band at a time, and only
          the bands below are actually built. Nothing here merges the containers
          — it links them.
        </p>
      </div>

      <article class="home-band">
        <h3>One store</h3>
        <p class="home-band__stat">
          <strong>{objectsTotal}</strong> typed objects ({schemaCount} schemas) ·{
            " "
          }
          <strong>{inReview}</strong> in review · <strong
            >{publishedCount}</strong
          >{" "}
          published
        </p>
        <ul class="home-schemas">
          {
            bySchema.map(([schema, n]) => (
              <li>
                <span class="home-schemas__label">{schema}</span>
                <span class="home-schemas__n">{n}</span>
              </li>
            ))
          }
        </ul>
        <p>
          The typed store lives in this repo (<code>kb/</code>, one markdown
          file per object) beside the CRM registry, which remains in refi-bcn-os
          (<code>data/crm.yaml</code>) with the org registries — one band of the
          common layer, not the whole of it. Local files hold field authority
          over the Notion mirror — the Flows band below states exactly how far
          that goes — and{" "}
          <a href={withBase("system/")}>/system</a> carries the authority table.
        </p>
        <p>
          {
            /* Computed, not asserted — the sibling idiom at system.astro:194
              on the identical quantity. Stating the relationship in prose
              would silently stop being true the moment `unattributed` goes
              non-zero or an infrastructure container holds objects. */
          }
          The containers themselves are attributed{" "}
          <strong>{src.totals.objects}</strong> of those objects; the remaining{
            " "
          }
          <strong>{objectsTotal - src.totals.objects}</strong> are source cards —
          a card describes a container rather than belonging to one.
        </p>
      </article>

      <article class="home-band">
        <h3>Common ontology — being defined</h3>
        <p>
          Each container keeps its own ontology: toolkit schemas over the old
          knowledge base, CRM rules over the registry, its own model over the
          map. The shared layer between them is deliberately gradual — it was
          tabled at the 260811 sync rather than settled, with Giulio leading and
          the OS↔Notion mapping doc as the starting point.
        </p>
        <p>
          Nothing here claims one vocabulary yet. The ontology row of the matrix
          above states what each container actually uses today.
        </p>
      </article>

      <article class="home-band">
        <h3>Publication gate</h3>
        <p>
          One gate, and it fails closed: only reviewed, in-scope objects
          publish, and they publish cut as curated collections — definitions
          over the store, never copies, recomputed at every build.
        </p>
        <ul class="home-band__list">
          {
            col.rows.map((c) => (
              <li>
                <a href={withBase(c.href)}>{c.title}</a> —{" "}
                <strong>{c.members_total}</strong> members ·{" "}
                <strong>{c.publishable_total}</strong> publishable
                {c.publishable_total === 0 &&
                  " — entries appear as review promotes them"}
              </li>
            ))
          }
        </ul>
        <p>
          <a href={withBase("collections/")}>/collections</a> renders whatever the
          reviewed definitions file holds.
        </p>
      </article>

      <article class="home-band">
        <h3>Flows</h3>
        {
          /* The claim here is about FIELD AUTHORITY, not direction. Checked
            against scripts/notion/ in the parent repo: pulls happen only
            where a rule sets `authority: "notion"` (plan.mjs:5, :26) and no
            rule does, so Notion never overwrites a local field — but the
            tasks and crm rules both set `import: { enabled: true }`
            (sync-rules.mjs:59, :87) and sync.mjs:217 appends those Notion
            rows into the local YAML under an explicit `--import`. "Pushes,
            never pulls" was simply false. */
        }
        <ul class="home-band__list">
          <li>
            <code>notion:sync</code> gives local YAML field authority — Notion never
            overwrites a field.
          </li>
          <li>
            Existence syncs both ways: local records are created in Notion, and
            Notion-created rows come down only under an explicit{" "}
            <code>--import</code>.
          </li>
          <li>The CRM build feed refreshes every 6 hours.</li>
          <li>Git carries history and review.</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ── public surfaces ─────────────────────────────────────────────── -->
  <SectionBlock
    id="surfaces"
    title="Public surfaces"
    alt={true}
    intro="The lenses a visitor reads: the knowledge base itself, the spatial and directory views fed live from the CRM, and the priorities above all of it."
  >
    <ul class="home-cards">
      {
        surfaces.map((s) => (
          <li class="card">
            <div class="card__body">
              <h3 class="card__title">
                <a href={s.href}>{s.label}</a>
              </h3>
              <p class="card__text">{s.blurb}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </SectionBlock>

  <!-- ── the tools band: over the system, not a container of it ───────── -->
  <section class="home-tools" aria-label="Working tools">
    <div class="home-tools__inner">
      {
        /* A real heading, not a styled span: /slices and /review are absent
          from the top nav, so this band is their only homepage path — it
          must exist in the accessible outline like every other section. */
      }
      <h2 class="home-tools__eyebrow">Working tools</h2>
      <ul>
        {
          tools.map((t) => (
            <li>
              <a href={t.href}>{t.label}</a>
              <span class="home-tools__note"> — {t.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .home-intro {
    max-width: var(--container-prose);
    margin: var(--space-16) auto var(--space-10);
    padding: 0 var(--gutter);
  }
  .home-note {
    margin-top: var(--space-4);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .home-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: var(--space-6) 0 0;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .home-strip div {
    display: flex;
    flex-direction: column;
  }
  .home-strip dt {
    font-family: var(--mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .home-strip dd {
    margin: 2px 0 0;
    font-family: var(--serif);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  /* ── the matrix ──
     A real table: layers are row headers, containers are column headers, so a
     screen reader announces "Ontology / Notion / CRM" rather than a soup of
     divs. Its width is set by the per-column minimums below and grows with
     the number of containers, which is already past any viewport — squeezing
     the columns down would destroy the comparison the table exists for, so it
     scrolls horizontally with the layer column pinned. */
  .home-matrix-scroll {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .home-matrix {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.82rem;
  }
  .home-matrix__caption {
    caption-side: top;
    text-align: left;
    padding: var(--space-3) var(--space-3) var(--space-2);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .home-matrix th,
  .home-matrix td {
    border-bottom: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }
  .home-matrix tr > *:last-child {
    border-right: 0;
  }
  .home-matrix tfoot tr > * {
    border-bottom: 0;
  }
  .home-matrix__corner,
  .home-matrix__layer {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--surface-1);
    width: 8rem;
    min-width: 8rem;
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }
  .home-matrix thead th {
    background: var(--surface-1);
    border-bottom: 1px solid var(--border-default);
  }
  .home-matrix__col {
    min-width: 12rem;
    font-weight: 500;
  }
  /* Planned columns read lighter via a TOKEN, not opacity. Opacity here
     stacked with the 0.6 that used to sit on `__none` and computed to ~0.49
     effective — about 2:1 against this surface, far under AA. --text-muted
     measures 5.05:1 on --surface-1, and the dashed rule plus the "planned"
     chip carry the distinction that the fading was doing. */
  .home-matrix__col--planned,
  .home-matrix__td--planned {
    border-right-style: dashed;
    color: var(--text-muted);
  }
  .home-matrix__name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-family: var(--serif);
    font-size: var(--text-md);
    color: var(--text-primary);
  }
  .home-matrix__name a {
    color: inherit;
  }
  .home-matrix__steward {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--text-muted);
  }
  .home-matrix__none {
    color: var(--text-muted);
  }
  .home-matrix__detail {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
  .home-matrix__gate {
    display: block;
    color: var(--text-primary);
  }
  .home-matrix__owner {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-muted);
  }
  .home-chip {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    padding: 1px 9px;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .home-chip--planned {
    border-style: dashed;
  }
  .home-sum {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 72ch;
  }
  .home-sum strong {
    color: var(--text-primary);
  }

  /* ── the common-layer bands ── */
  .home-bands {
    padding: var(--space-16) var(--gutter);
    background: var(--surface-1);
    border-top: 1px solid var(--border-subtle);
  }
  .home-bands__inner {
    max-width: var(--container-default);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
