---
import Layout from "../components/Layout.astro";
import { withBase } from "../lib/paths";

// Placeholder index — each section is scaffolded by a later task.
const sections = [
  {
    label: "Commons",
    href: withBase("commons/"),
    blurb: "Public knowledge base pages compiled from the org-os KB engine.",
  },
  {
    label: "Atlas",
    href: withBase("atlas/"),
    blurb:
      "Catalunya map — comarques, territories and where the work is happening.",
  },
  {
    label: "Organizations",
    href: withBase("organizations/"),
    blurb:
      "Directory of organizations in the network, fed from the Notion CRM.",
  },
  {
    label: "Programs",
    href: withBase("programs/"),
    blurb: "Programs and initiatives running across the bioregion.",
  },
  {
    label: "Events",
    href: withBase("events/"),
    blurb: "Gatherings, workshops and assemblies.",
  },
  {
    label: "Priorities",
    href: withBase("priorities/"),
    blurb: "Bioregional priorities and the indicators behind them.",
  },
];
---

<Layout title="Home" current="home">
  <header class="intro">
    <p class="eyebrow">Knowledge Commons</p>
    <h1 class="display">A shared knowledge base for ReFi Barcelona.</h1>
    <p class="lede">
      Two feeds — the local knowledge base compiled by the org-os KB engine, and
      the Notion CRM behind the directory and the atlas. Published as a commons.
    </p>
  </header>

  <section class="sections">
    <ul>
      {
        sections.map((s) => (
          <li class="card">
            <div class="card__body">
              <h2 class="card__title">
                <a href={s.href}>{s.label}</a>
              </h2>
              <p class="card__text">{s.blurb}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .intro {
    max-width: var(--container-prose);
    margin: var(--space-16) auto var(--space-12);
    padding: 0 var(--gutter);
  }
  .sections {
    max-width: var(--container-default);
    margin: 0 auto var(--space-24);
  }
  .sections ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
  }
  .card__title a {
    text-decoration: none;
  }
  .card__title a:hover {
    text-decoration: underline;
  }
</style>
