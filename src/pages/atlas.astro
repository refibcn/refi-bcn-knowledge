---
import Layout from "../components/Layout.astro";
import SourceCrumb from "../components/SourceCrumb.astro";
import CatalunyaProgramMap from "../components/CatalunyaProgramMap.astro";
import { getCollection } from "astro:content";
import { withBase } from "../lib/paths";
import {
  fetchAtlasRecords,
  toMarkers,
  toComarcaPlacements,
  largestRingCentroid,
  legendEntries,
  classifyUnplaced,
  assertUniqueAnchors,
  actorAnchor,
} from "../lib/atlas-data.mjs";
import { hasCatbis } from "../lib/crm";
// Soft banner locally, hard build failure under REQUIRE_NOTION=1 (CI).
import { crmFailure } from "../lib/crm-strict.mjs";
// Bundle-time read of the comarca geometry, per the `?raw` convention in
// src/lib/site.ts. This is build-only — the browser still fetches the same file
// from public/ via the map's data-geo-url, so nothing extra ships to the client.
import comarquesRaw from "../../public/geo/catalunya-comarques.geojson?raw";

// Ported from refibcn-site. Two adaptations for this repo:
//   - `current="atlas"` — this site's nav has its own Atlas item, where the
//     sibling folded the atlas under Commons.
//   - The sibling's "Program dashboard" / "Article view" links are dropped:
//     /projects/regenerant-catalunya/* lives on refibcn.cat and has no route
//     here, so keeping them would ship two known-dead links.
const entries = await getCollection("cohort");
const doc = entries[0]!.data;

// ── CRM actor layers (Task 13) ────────────────────────────────────────────
// Actors come from the ReFi BCN CRM at build time. A missing NOTION_API_KEY or
// an API failure degrades to the cohort-only map rather than failing the build,
// matching how the directory pages handle the same seam.
//
// TWO PLACEMENT PATHS, deliberately:
//
//   1. Points, from Lat/Lng. The CRM has no such properties today — verified
//      against the full property-key union of all 608 records, not a sample —
//      so this yields nothing. The code is kept because it is correct and
//      lights up on its own the moment actors are geocoded.
//   2. Comarques, from the `Area2` multi-select. Its comarca options are the
//      same territorial divisions as the geojson's `nom_comar` values, so the
//      two join by name. This is the geography the CRM actually has.
//
// Area2 values that carry no polygon are left unplaced rather than guessed at.
// `classifyUnplaced()` says WHY each one is unplaced — province/regional scope,
// a comarca missing from this geojson, or an enum option the map has never seen
// — so the page can state the reason instead of assuming it.

// Comarca name set + centroids, read off the same geojson the map draws.
// Nine comarques appear as two features (mainland + exclave), so features are
// grouped by name and their polygons concatenated before taking a centroid —
// otherwise the badge would land on whichever part happened to come first.
const comarquesGeo = JSON.parse(comarquesRaw) as {
  features: { properties: { nom_comar: string }; geometry: any }[];
};
const polygonsByComarca = new Map<string, any[]>();
for (const feature of comarquesGeo.features) {
  const name = feature.properties?.nom_comar;
  if (!name) continue;
  const polygons =
    feature.geometry?.type === "Polygon"
      ? [feature.geometry.coordinates]
      : (feature.geometry?.coordinates ?? []);
  polygonsByComarca.set(name, [
    ...(polygonsByComarca.get(name) ?? []),
    ...polygons,
  ]);
}
const comarcaIndex = [...polygonsByComarca.keys()];
const centroidByComarca = new Map<string, [number, number] | null>(
  [...polygonsByComarca].map(([name, polygons]) => [
    name,
    largestRingCentroid({ type: "MultiPolygon", coordinates: polygons }),
  ]),
);

let crmRecordCount = 0;
let crmMarkers: ReturnType<typeof toMarkers> = [];
let crmComarcas: {
  comarca: string;
  actors: { name: string; category: string | null; tags: string[] }[];
  centroid: [number, number] | null;
}[] = [];
let placedActorCount = 0;
let unplaced: ReturnType<typeof classifyUnplaced> = {
  total: 0,
  scopeOnly: 0,
  absentComarca: 0,
  unrecognised: 0,
  unrecognisedValues: [],
};
let unplacedMissingFromDirectory = 0;
// Anchors the directory page actually renders. The atlas draws every CRM
// actor, but /organizations filters through hasCatbis, so an atlas popup can
// point at an anchor that does not exist. Links are emitted only for anchors
// in this set; the rest render as plain text.
let directoryAnchors: string[] = [];
let crmError: string | null = null;
try {
  const records = await fetchAtlasRecords();
  crmRecordCount = records.length;
  crmMarkers = toMarkers(records);

  const placements = toComarcaPlacements(records, comarcaIndex);
  crmComarcas = placements.map((p) => ({
    ...p,
    centroid: centroidByComarca.get(p.comarca) ?? null,
  }));

  // Distinct actors, not the sum of per-comarca lists — a record spanning two
  // comarques is placed twice but is still one actor.
  placedActorCount = new Set(
    placements.flatMap((p) => p.actors.map((a) => a.name)),
  ).size;

  // hasCatbis is imported from the directory's own module rather than
  // reimplemented, so "what the directory renders" has one definition.
  const directoryNames = records
    .filter(hasCatbis)
    .map((r) => String(r.properties?.["Name"] ?? "").trim())
    .filter(Boolean);
  assertUniqueAnchors(directoryNames, "the /organizations directory");
  const anchorSet = new Set(directoryNames.map((n) => actorAnchor(n)));
  directoryAnchors = [...anchorSet];

  unplaced = classifyUnplaced(records, comarcaIndex);

  // Verify the claim before making it: how many unplaced actors are also
  // absent from the directory, so the page cannot promise a page they are
  // not on.
  const placedNames = new Set(
    placements.flatMap((p) => p.actors.map((a) => a.name)),
  );
  unplacedMissingFromDirectory = records.filter((r) => {
    const name = String(r.properties?.["Name"] ?? "").trim();
    if (!name || placedNames.has(name)) return false;
    const area2 = r.properties?.["Area2"];
    const values = Array.isArray(area2) ? area2 : area2 ? [area2] : [];
    return values.length > 0 && !anchorSet.has(actorAnchor(name));
  }).length;

  if (unplaced.unrecognisedValues.length > 0) {
    console.warn(
      `[atlas] Unrecognised Area2 value(s), not drawn and not described as ` +
        `province/regional: ${unplaced.unrecognisedValues.join(", ")}`,
    );
  }
} catch (e) {
  // Note this catch spans the placement logic too, not just the fetch — so
  // under REQUIRE_NOTION=1 an anchor collision caught by assertUniqueAnchors()
  // stops the deploy instead of degrading to a banner. That is deliberate: a
  // collision silently breaks every atlas → directory link, and CI is exactly
  // where nobody is watching the banner.
  crmError = crmFailure(e, "the atlas", import.meta.env.REQUIRE_NOTION);
}

const directoryHref = withBase("organizations/");

// The legend is derived from AGENCY_PRECEDENCE in src/lib/atlas-data.mjs — the
// same array that decides every category. Do not restate it here.
const legend = legendEntries();

// Legend counts span both placement paths, deduped by actor name so a record
// placed in two comarques is not counted twice.
const placedByCategory = new Map<string | null, Set<string>>();
for (const entry of [
  ...crmComarcas.flatMap((c) => c.actors),
  ...crmMarkers.map((m) => ({ name: m.name, category: m.category })),
]) {
  const bucket = placedByCategory.get(entry.category) ?? new Set<string>();
  bucket.add(entry.name);
  placedByCategory.set(entry.category, bucket);
}
const countFor = (id: string | null) => placedByCategory.get(id)?.size ?? 0;
const uncategorized = countFor(null);

// Built as text rather than nested JSX so the punctuation stays tight — each
// clause is only emitted when its bucket is non-empty, and every number here is
// computed by classifyUnplaced() rather than assumed.
const unplacedReasons = [
  unplaced.scopeOnly > 0 &&
    `${unplaced.scopeOnly} name only a province or regional scope`,
  unplaced.absentComarca > 0 &&
    `${unplaced.absentComarca} name a comarca missing from this geojson`,
  unplaced.unrecognised > 0 &&
    `${unplaced.unrecognised} name an unrecognised value (${unplaced.unrecognisedValues.join(", ")})`,
].filter((clause): clause is string => typeof clause === "string");
const unplacedReasonText =
  unplacedReasons.length > 0 ? ` — ${unplacedReasons.join("; ")}` : "";
---

<Layout
  title="Atlas"
  current="atlas"
  section="Knowledge"
  dataset="Catalunya"
  description="A living atlas of Catalunya's regenerative territory — actors, cohorts, and bioregional signals."
>
  <SourceCrumb
    container="notion-refi-bcn"
    note="placed by comarca from the CRM's Area2 field — the CRM holds no coordinates"
  />
  <section class="atlas-head">
    <h1>Atlas</h1>
    <p class="lede">
      Catalunya's regenerative territory, mapped — the Regenerant Catalunya
      cohort across its comarques, scouted by the Miceli (rural) and La Fundició
      / Keras Buti (urban) networks.
    </p>
  </section>
  <section class="atlas-map">
    <CatalunyaProgramMap
      projects={doc.projects}
      networks={doc.networks}
      crmMarkers={crmMarkers}
      crmComarcas={crmComarcas}
      crmDirectoryHref={directoryHref}
      directoryAnchors={directoryAnchors}
    />
  </section>

  <section class="atlas-legend">
    <div class="legend-head">
      <h2>Actor legend</h2>
      <p class="legend-note">
        Actors carry more than one <code>agency</code> value, so each is placed in
        the first bucket it matches, reading down this list.
      </p>
    </div>

    <ul class="legend-list">
      {
        legend.map((entry) => (
          <li class="legend-item">
            <span
              class="legend-swatch"
              style={`--swatch:${entry.color}`}
              aria-hidden="true"
            />
            <span class="legend-label">{entry.label}</span>
            <span class="legend-count">{countFor(entry.id)}</span>
          </li>
        ))
      }
      {
        uncategorized > 0 && (
          <li class="legend-item">
            <span
              class="legend-swatch legend-swatch--none"
              aria-hidden="true"
            />
            <span class="legend-label">Uncategorised</span>
            <span class="legend-count">{uncategorized}</span>
          </li>
        )
      }
    </ul>

    <p class="provenance">
      {
        crmError ? (
          `CRM layer unavailable at build time — ${crmError} The cohort map above is unaffected.`
        ) : (
          <>
            <strong>{placedActorCount}</strong> of {crmRecordCount} CRM actors
            placed by comarca, across {crmComarcas.length} comarques;{" "}
            <strong>{crmMarkers.length}</strong> carry point coordinates.
            Comarca placement comes from each record's <code>Area2</code> value,
            so an actor is shaded across its whole comarca rather than pinned to
            an address — precise coordinates would replace that with an exact
            location.
            {unplaced.total > 0 && (
              <>
                {" "}
                A further <strong>{unplaced.total}</strong> actors carry an{" "}
                <code>Area2</code> the map cannot draw{unplacedReasonText}.{" "}
                {unplacedMissingFromDirectory > 0 ? (
                  <>
                    Most appear in the <a href={directoryHref}>directory</a> —{" "}
                    <strong>{unplacedMissingFromDirectory}</strong> do not,
                    because it lists only CATBIS-tagged actors while the atlas
                    counts the whole CRM.
                  </>
                ) : (
                  <>
                    They are listed in the <a href={directoryHref}>directory</a>{" "}
                    but not drawn here.
                  </>
                )}
              </>
            )}
          </>
        )
      }
    </p>

    {
      crmComarcas.length > 0 && (
        <details class="comarca-breakdown">
          <summary>Actors by comarca</summary>
          <ul class="comarca-list">
            {crmComarcas.map((c) => (
              <li>
                <span class="comarca-name">{c.comarca}</span>
                <span class="comarca-count">{c.actors.length}</span>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </section>
</Layout>

<style>
  .atlas-head {
    max-width: var(--container-default, 1120px);
    margin: 0 auto;
    padding: 28px 20px 10px;
  }
  .atlas-map {
    max-width: var(--container-wide, 1360px);
    margin: 0 auto 28px;
    padding: 0 20px;
  }
  .atlas-map :global(.program-map) {
    height: min(78vh, 880px);
  }
  .atlas-legend {
    max-width: var(--container-default, 1120px);
    margin: 0 auto 56px;
    padding: 0 20px;
  }
  .legend-head h2 {
    margin: 0;
    font-size: 1rem;
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .legend-note {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: var(--rule);
    max-width: 60ch;
  }
  .legend-list {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .legend-swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--swatch);
    flex: none;
  }
  .legend-swatch--none {
    background: #8a8378;
  }
  .legend-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .legend-count {
    color: var(--rule);
  }
  .provenance {
    margin: 1rem 0 0;
    font-size: 0.78rem;
    color: var(--rule);
    max-width: 70ch;
    line-height: 1.55;
  }
  .provenance strong {
    color: var(--ink);
  }
  .comarca-breakdown {
    margin: 0.9rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .comarca-breakdown summary {
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--rule);
  }
  .comarca-list {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.25rem 1.5rem;
  }
  .comarca-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px dotted var(--rule);
    padding-bottom: 0.15rem;
  }
  .comarca-count {
    color: var(--rule);
  }
</style>
