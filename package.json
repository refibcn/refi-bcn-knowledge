{
  "name": "refi-bcn-knowledge",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "ReFi BCN knowledge instance — public knowledge lens, internal review lens, Catalunya atlas, source containers, and the Notion-CRM-fed directory.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-public-kb.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "export:public-kb": "node scripts/export-public-kb.mjs",
    "derive:disposition": "node scripts/derive-disposition.mjs",
    "derive:kb-summary": "node scripts/derive-kb-summary.mjs",
    "protect:review": "node scripts/protect-review.mjs",
    "verify:review": "node scripts/verify-review-protected.mjs",
    "build:internal": "COMMONS_REVIEW=1 astro build && npm run protect:review && npm run verify:review",
    "check": "astro check && prettier . --check",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.0.0",
    "@fontsource-variable/geist": "^5.0.0",
    "@fontsource-variable/geist-mono": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource/averia-serif-libre": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@notionhq/client": "^3.1.0",
    "astro": "^5.0.0",
    "js-yaml": "^4.1.1",
    "maplibre-gl": "^5.24.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/js-yaml": "^4.0.9",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "staticrypt": "^3.5.4",
    "typescript": "^5.9.3"
  }
}
