---
// src/components/CatalunyaProgramMap.astro
// Article-view interactive program map using MapLibre GL + hosted vector tiles
// (OpenFreeMap "positron"). Constrained to Catalunya, comarca overlay, custom
// project markers with click-to-popover, province quick-zoom, L'Hospitalet
// shortcut, on-screen zoom controls.
import type { Project, NetworkMeta } from "../content.config";
import { initialTileDataUrl } from "../lib/initial-tile";
import { withBase } from "../lib/paths";
import {
  AGENCY_COLORS,
  UNCATEGORIZED_COLOR,
  COMARCA_DENSITY_COLOR,
  densityOpacity,
  actorAnchor,
} from "../lib/atlas-data.mjs";

interface CrmMarker {
  name: string;
  lat: number;
  lng: number;
  category: string | null;
  tags: string[];
}

interface CrmComarca {
  comarca: string;
  actors: { name: string; category: string | null; tags: string[] }[];
  /** `[lng, lat]` of the comarca's largest polygon, for the count badge. */
  centroid: [number, number] | null;
}

interface Props {
  projects: Project[];
  networks: Record<"miceli" | "keras-buti", NetworkMeta>;
  /** CRM actor markers (Task 13). Optional and additive — omit them and the
   *  map renders exactly as ported. */
  crmMarkers?: CrmMarker[];
  /** CRM actors placed by comarca, ranked. Also optional and additive. */
  crmComarcas?: CrmComarca[];
  /** Page the popup "view in directory" link points at. */
  crmDirectoryHref?: string;
  /** Anchors that page actually renders. An actor whose anchor is absent gets
   *  plain text instead of a link — /organizations filters through hasCatbis,
   *  so not every CRM actor on the map has a card to link to. */
  directoryAnchors?: string[];
}
const {
  projects,
  networks,
  crmMarkers = [],
  crmComarcas = [],
  crmDirectoryHref = "",
  directoryAnchors = [],
} = Astro.props;
const directoryAnchorSet = new Set(directoryAnchors);
/** Link target for an actor, or null when the directory has no such card. */
const actorHref = (name: string): string | null => {
  const anchor = actorAnchor(name);
  if (!crmDirectoryHref || !directoryAnchorSet.has(anchor)) return null;
  return `${crmDirectoryHref}#${anchor}`;
};
// Ported from refibcn-site; the only change is that public-asset URLs go
// through withBase() per this repo's convention instead of hand-trimming
// BASE_URL. The client script reads the resolved URL off `data-geo-url`, so it
// needs no base awareness of its own.
const geoUrl = withBase("geo/catalunya-comarques.geojson");

// GeoJSON FeatureCollection for the marker layer
const markerFeatures = projects.map((p) => ({
  type: "Feature" as const,
  geometry: { type: "Point" as const, coordinates: [p.geo.lng, p.geo.lat] },
  properties: {
    id: p.id,
    name: p.name,
    network: p.network,
    locality: p.locality,
  },
}));
const markersGeoJson = {
  type: "FeatureCollection" as const,
  features: markerFeatures,
};

// Comarques (nom_comar field in the GeoJSON — schema: cap_comar, comarca, nom_comar) that contain a confirmed project.
const PROJECT_COMARQUES = new Set([
  "Garrotxa",
  "Anoia",
  "Bages",
  "Berguedà",
  "Barcelonès",
  "Baix Llobregat",
  "Ripollès",
]);

// Network anchor nodes GeoJSON
const networkNodesGeoJson = {
  type: "FeatureCollection" as const,
  features: [
    {
      type: "Feature" as const,
      geometry: { type: "Point" as const, coordinates: [2.2, 42.2] },
      properties: {
        id: "miceli",
        label: "MICELI SOCIAL",
        role: "Rural network",
        network: "miceli",
      },
    },
    {
      type: "Feature" as const,
      geometry: { type: "Point" as const, coordinates: [2.1, 41.36] },
      properties: {
        id: "keras-buti",
        label: "LA FUNDICIÓ / KERAS BUTI",
        role: "Urban network",
        network: "keras-buti",
      },
    },
  ],
};

// CRM actor layer (Task 13). The per-feature `color` is resolved here from the
// shared AGENCY_COLORS map so the client script needs no taxonomy knowledge and
// the legend swatches cannot drift from the marker fills.
const crmGeoJson = {
  type: "FeatureCollection" as const,
  features: crmMarkers.map((m) => ({
    type: "Feature" as const,
    geometry: { type: "Point" as const, coordinates: [m.lng, m.lat] },
    properties: {
      name: m.name,
      category: m.category ?? "",
      // Pipe-joined: MapLibre feature properties are flat scalars, not arrays.
      tags: m.tags.join(" | "),
      color:
        (m.category && (AGENCY_COLORS as Record<string, string>)[m.category]) ||
        UNCATEGORIZED_COLOR,
      href: actorHref(m.name) ?? "",
    },
  })),
};

// Comarca placement payload (Area2 → nom_comar). Opacity and per-actor colour
// are resolved here from the shared palette so the client script carries no
// taxonomy or scale knowledge of its own.
const maxComarcaCount = crmComarcas.reduce(
  (max, c) => Math.max(max, c.actors.length),
  0,
);
const crmComarcaPayload = {
  comarcas: crmComarcas.map((c) => ({
    comarca: c.comarca,
    count: c.actors.length,
    opacity: densityOpacity(c.actors.length, maxComarcaCount),
    centroid: c.centroid,
    actors: c.actors.map((a) => ({
      name: a.name,
      tags: a.tags,
      color:
        (a.category && (AGENCY_COLORS as Record<string, string>)[a.category]) ||
        UNCATEGORIZED_COLOR,
      href: actorHref(a.name) ?? "",
    })),
  })),
  densityColor: COMARCA_DENSITY_COLOR,
  directoryHref: crmDirectoryHref,
};

const cardImage = (p: Project): string => {
  if (p.image) return withBase(p.image);
  const meta = networks[p.network];
  return initialTileDataUrl({ initial: p.name.charAt(0), accent: meta.accent });
};
---

<div class="program-map" data-program-map data-geo-url={geoUrl}>
  <div class="map-controls" aria-label="Map navigation">
    <div class="province-strip" role="tablist">
      <button class="prov-chip active" data-prov="catalunya" type="button"
        >Catalunya</button
      >
      <button class="prov-chip" data-prov="barcelona" type="button"
        >Barcelona</button
      >
      <button class="prov-chip" data-prov="tarragona" type="button"
        >Tarragona</button
      >
      <button class="prov-chip" data-prov="lleida" type="button">Lleida</button>
      <button class="prov-chip" data-prov="girona" type="button">Girona</button>
      <button class="prov-chip" data-prov="lhospitalet" type="button"
        >L'Hospitalet</button
      >
      <span class="strip-divider" aria-hidden="true"></span>
      <button
        class="prov-chip net-chip"
        data-network="miceli"
        data-prov="miceli"
        type="button">Miceli</button
      >
      <button
        class="prov-chip net-chip"
        data-network="keras-buti"
        data-prov="kerasbuti"
        type="button">La Fundició</button
      >
    </div>
    <p class="map-hint">Click a marker · Scroll to zoom · Drag to pan</p>
  </div>

  <div class="maplibre-host" data-maplibre-host></div>

  <div class="zoom-buttons" aria-label="Zoom controls">
    <button class="zoom-btn" data-zoom-in type="button" aria-label="Zoom in"
      >+</button
    >
    <button class="zoom-btn" data-zoom-out type="button" aria-label="Zoom out"
      >−</button
    >
    <button
      class="zoom-btn"
      data-zoom-reset
      type="button"
      aria-label="Fit Catalunya">↺</button
    >
  </div>

  <!-- Pre-rendered popover cards (hidden by default; revealed on marker click). -->
  <div class="popover-stack" aria-live="polite">
    {
      projects.map((p) => {
        const meta = networks[p.network];
        const themeLabel = p.theme.replace(/-/g, " ");
        return (
          <article
            class="popover-card"
            data-popover-id={p.id}
            data-network={p.network}
            hidden
          >
            <button
              class="popover-close"
              type="button"
              aria-label="Close project"
            >
              ×
            </button>
            <div class="image-wrap">
              <img
                src={cardImage(p)}
                alt={`${p.name} — ${p.theme}`}
                loading="lazy"
              />
              <span class="network-chip" data-accent={meta.accent}>
                {meta.name.split(" / ")[0]}
              </span>
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <p class="locality">{p.locality}</p>
              <p class="summary">{p.summary}</p>
              <div class="meta">
                <span class="theme-tag">{themeLabel}</span>
                {p.links.web && (
                  <a
                    class="ext-link"
                    href={p.links.web}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    ↗ visit
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <script
    type="application/json"
    data-markers
    set:html={JSON.stringify(markersGeoJson)}
  />
  <script
    type="application/json"
    data-network-nodes
    set:html={JSON.stringify(networkNodesGeoJson)}
  />
  <script
    type="application/json"
    data-crm-markers
    set:html={JSON.stringify(crmGeoJson)}
  />
  <script
    type="application/json"
    data-crm-comarcas
    set:html={JSON.stringify(crmComarcaPayload)}
  />
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  // CRM popup content is built as an HTML string for MapLibre's setHTML, so
  // every interpolated value goes through here first.
  function escapeHtml(value: string): string {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  // Tile source — free, no API key, OSM-based, MapLibre-compatible.
  // Swap to a Protomaps PMTiles or MapTiler URL later if we want self-hosted / branded styling.
  const TILE_STYLE = "https://tiles.openfreemap.org/styles/positron";

  // Catalunya bounds (SW [lng, lat], NE [lng, lat]) — pan + zoom can't escape this box.
  const CATALUNYA_BOUNDS: [[number, number], [number, number]] = [
    [-0.5, 40.3],
    [3.6, 43.0],
  ];

  // Province / L'Hospitalet bounding boxes for the chip-driven fit-to-bounds.
  type BBox = [[number, number], [number, number]];
  const PROVINCE_BOUNDS: Record<string, BBox> = {
    catalunya: [
      [0.15, 40.52],
      [3.32, 42.86],
    ],
    barcelona: [
      [1.45, 41.16],
      [2.85, 42.05],
    ],
    tarragona: [
      [0.1, 40.52],
      [1.65, 41.45],
    ],
    lleida: [
      [0.55, 41.3],
      [1.85, 42.86],
    ],
    girona: [
      [1.85, 41.6],
      [3.32, 42.55],
    ],
    lhospitalet: [
      [1.95, 41.3],
      [2.25, 41.42],
    ],
    miceli: [
      [1.3, 41.4],
      [2.85, 42.55],
    ], // rural Catalunya cluster
    kerasbuti: [
      [1.95, 41.3],
      [2.25, 41.42],
    ], // L'Hospitalet metro
  };

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document
    .querySelectorAll<HTMLDivElement>("[data-program-map]")
    .forEach((host) => {
      const mapHost = host.querySelector<HTMLDivElement>(
        "[data-maplibre-host]",
      );
      const markersEl = host.querySelector<HTMLScriptElement>("[data-markers]");
      const networkNodesEl = host.querySelector<HTMLScriptElement>(
        "[data-network-nodes]",
      );
      if (!mapHost || !markersEl) return;
      const geoUrl = host.dataset.geoUrl ?? "/geo/catalunya-comarques.geojson";
      const markersGeo = JSON.parse(
        markersEl.textContent ?? '{"type":"FeatureCollection","features":[]}',
      );
      const networkNodesGeo = JSON.parse(
        networkNodesEl?.textContent ??
          '{"type":"FeatureCollection","features":[]}',
      );
      const crmMarkersEl =
        host.querySelector<HTMLScriptElement>("[data-crm-markers]");
      const crmGeo = JSON.parse(
        crmMarkersEl?.textContent ??
          '{"type":"FeatureCollection","features":[]}',
      );
      const crmComarcasEl = host.querySelector<HTMLScriptElement>(
        "[data-crm-comarcas]",
      );
      type CrmComarcaEntry = {
        comarca: string;
        count: number;
        opacity: number;
        centroid: [number, number] | null;
        actors: { name: string; tags: string[]; color: string; href: string }[];
      };
      const crmComarcaData: {
        comarcas: CrmComarcaEntry[];
        densityColor: string;
        directoryHref: string;
      } = JSON.parse(
        crmComarcasEl?.textContent ??
          '{"comarcas":[],"densityColor":"#3d5a80","directoryHref":""}',
      );
      const crmComarcas = crmComarcaData.comarcas ?? [];
      const crmComarcaByName = new Map(crmComarcas.map((c) => [c.comarca, c]));

      // Popup listing the actors placed in one comarca. Long lists are capped
      // and spill over to the directory rather than growing an unusable popup.
      const COMARCA_POPUP_LIMIT = 12;
      function comarcaPopupHtml(entry: CrmComarcaEntry): string {
        const shown = entry.actors.slice(0, COMARCA_POPUP_LIMIT);
        const rest = entry.actors.length - shown.length;
        return [
          '<div class="crm-popup crm-popup--comarca">',
          `<p class="crm-popup__name">${escapeHtml(entry.comarca)}</p>`,
          `<p class="crm-popup__meta">${entry.count} actor${entry.count === 1 ? "" : "s"} in the CRM</p>`,
          '<ul class="crm-popup__actors">',
          shown
            .map((a) => {
              const dot = `<span class="crm-popup__dot" style="background:${escapeHtml(a.color)}"></span>`;
              // No href means the directory has no card for this actor, so it
              // renders as plain text rather than a link to a missing anchor.
              const label = a.href
                ? `<a href="${escapeHtml(a.href)}">${dot}${escapeHtml(a.name)}</a>`
                : `<span class="crm-popup__plain">${dot}${escapeHtml(a.name)}</span>`;
              const chips = a.tags.length
                ? `<span class="crm-popup__chips">${a.tags
                    .map(
                      (t) =>
                        `<span class="crm-popup__chip">${escapeHtml(t)}</span>`,
                    )
                    .join("")}</span>`
                : "";
              return `<li>${label}${chips}</li>`;
            })
            .join(""),
          "</ul>",
          rest > 0 && crmComarcaData.directoryHref
            ? `<a class="crm-popup__link" href="${escapeHtml(crmComarcaData.directoryHref)}">+${rest} more in the directory &rarr;</a>`
            : "",
          "</div>",
        ].join("");
      }

      function openComarcaPopup(
        name: string,
        lngLat: [number, number],
        map: maplibregl.Map,
      ) {
        const entry = crmComarcaByName.get(name);
        if (!entry) return;
        new maplibregl.Popup({
          closeButton: true,
          offset: 10,
          maxWidth: "320px",
        })
          .setLngLat(lngLat)
          .setHTML(comarcaPopupHtml(entry))
          .addTo(map);
      }

      const map = new maplibregl.Map({
        container: mapHost,
        style: TILE_STYLE,
        center: [1.7, 41.85],
        zoom: 7.4,
        minZoom: 6,
        maxZoom: 14,
        maxBounds: CATALUNYA_BOUNDS,
        attributionControl: { compact: true },
        cooperativeGestures: false,
        dragRotate: false,
        pitchWithRotate: false,
        touchZoomRotate: true,
      });
      // Disable rotation entirely — keeps the map oriented with north up.
      map.touchZoomRotate.disableRotation();

      map.on("load", async () => {
        // Subtle palette tweaks on top of the positron base — push it toward our paper-and-ink feel.
        desaturateBaseStyle(map);
        // Hide OSM city/town/village/place labels — keep only our own labels.
        hideOsmPlaceLabels(map);

        // Comarques overlay (line + data-driven fill for project comarques + labels)
        const projectComarquesArr = [
          "Garrotxa",
          "Anoia",
          "Bages",
          "Berguedà",
          "Barcelonès",
          "Baix Llobregat",
          "Ripollès",
        ];
        try {
          const geoResp = await fetch(geoUrl);
          const geo = await geoResp.json();
          map.addSource("comarques", { type: "geojson", data: geo });
          map.addLayer({
            id: "comarques-fill",
            type: "fill",
            source: "comarques",
            paint: {
              "fill-color": "#8B5A3C",
              "fill-opacity": [
                "case",
                ["in", ["get", "nom_comar"], ["literal", projectComarquesArr]],
                0.14,
                0.0,
              ],
            } as any,
          });
          // CRM comarca density (Task 13 follow-up). Sits directly on top of
          // the cohort fill and below the borders/labels, so it reads as a
          // second overlay on the same polygons rather than replacing them.
          if (crmComarcas.length > 0) {
            const opacityMatch: any[] = ["match", ["get", "nom_comar"]];
            for (const entry of crmComarcas) {
              opacityMatch.push(entry.comarca, entry.opacity);
            }
            opacityMatch.push(0);

            map.addLayer({
              id: "crm-comarca-fill",
              type: "fill",
              source: "comarques",
              paint: {
                "fill-color": crmComarcaData.densityColor,
                "fill-opacity": opacityMatch,
              } as any,
            });

            map.on("click", "crm-comarca-fill", (e) => {
              const name = e.features?.[0]?.properties?.nom_comar as
                string | undefined;
              if (!name || !crmComarcaByName.has(name)) return;
              // Markers own the click when one is under the cursor.
              const overMarker = map
                .queryRenderedFeatures(e.point, {
                  layers: ["projects-dot", "crm-actors-dot"].filter((id) =>
                    map.getLayer(id),
                  ),
                })
                .some(Boolean);
              if (overMarker) return;
              openComarcaPopup(name, [e.lngLat.lng, e.lngLat.lat], map);
            });
            map.on("mousemove", "crm-comarca-fill", (e) => {
              const name = e.features?.[0]?.properties?.nom_comar as
                string | undefined;
              map.getCanvas().style.cursor =
                name && crmComarcaByName.has(name) ? "pointer" : "";
            });
            map.on(
              "mouseleave",
              "crm-comarca-fill",
              () => (map.getCanvas().style.cursor = ""),
            );
          }

          map.addLayer({
            id: "comarques-line",
            type: "line",
            source: "comarques",
            paint: {
              "line-color": "#1d1a16",
              "line-width": 0.6,
              "line-dasharray": [2, 3],
              "line-opacity": 0.55,
            },
          });
          // Comarca name labels — subtle, mono caps. Show all at zoom ≥ 8; project-bearing
          // comarques get a more visible label that's already visible at Catalunya zoom (≥ 7).
          map.addLayer({
            id: "comarques-label",
            type: "symbol",
            source: "comarques",
            minzoom: 8,
            layout: {
              "text-field": ["get", "nom_comar"],
              "text-font": ["Noto Sans Regular", "Open Sans Regular"],
              "text-size": 10,
              "text-letter-spacing": 0.08,
              "text-transform": "uppercase",
              "text-allow-overlap": false,
              "text-padding": 4,
            },
            paint: {
              "text-color": "#1d1a16",
              "text-opacity": 0.6,
              "text-halo-color": "#fbf9f3",
              "text-halo-width": 1.5,
            },
          });
          // Project-bearing comarques: name visible from the default Catalunya overview zoom.
          map.addLayer({
            id: "comarques-label-project",
            type: "symbol",
            source: "comarques",
            filter: [
              "in",
              ["get", "nom_comar"],
              ["literal", projectComarquesArr],
            ] as any,
            minzoom: 6.5,
            maxzoom: 8,
            layout: {
              "text-field": ["get", "nom_comar"],
              "text-font": ["Noto Sans Regular", "Open Sans Regular"],
              "text-size": 10,
              "text-letter-spacing": 0.1,
              "text-transform": "uppercase",
              "text-allow-overlap": false,
              "text-padding": 6,
            },
            paint: {
              "text-color": "#1d1a16",
              "text-opacity": 0.7,
              "text-halo-color": "#fbf9f3",
              "text-halo-width": 2,
            },
          });

          // Count badges, one per comarca, at the centroid of its largest
          // polygon. Their own point source rather than the polygon source:
          // nine comarques are split across two features in this geojson and a
          // symbol layer on the polygons would draw a duplicate badge on each.
          const badgeFeatures = crmComarcas
            .filter((entry) => Array.isArray(entry.centroid))
            .map((entry) => ({
              type: "Feature" as const,
              geometry: {
                type: "Point" as const,
                coordinates: entry.centroid as [number, number],
              },
              properties: { comarca: entry.comarca, count: entry.count },
            }));

          if (badgeFeatures.length > 0) {
            map.addSource("crm-comarca-badges", {
              type: "geojson",
              data: { type: "FeatureCollection", features: badgeFeatures },
            });
            map.addLayer({
              id: "crm-comarca-badge",
              type: "circle",
              source: "crm-comarca-badges",
              paint: {
                "circle-radius": [
                  "interpolate",
                  ["linear"],
                  ["zoom"],
                  7,
                  9,
                  11,
                  13,
                ] as any,
                "circle-color": "#fbf9f3",
                "circle-stroke-width": 1.2,
                "circle-stroke-color": crmComarcaData.densityColor,
                "circle-opacity": 0.95,
              },
            });
            map.addLayer({
              id: "crm-comarca-badge-count",
              type: "symbol",
              source: "crm-comarca-badges",
              layout: {
                "text-field": ["to-string", ["get", "count"]],
                "text-font": ["IBM Plex Mono Regular", "Open Sans Regular"],
                "text-size": 11,
                "text-allow-overlap": true,
              },
              paint: { "text-color": crmComarcaData.densityColor },
            });

            map.on("click", "crm-comarca-badge", (e) => {
              const name = e.features?.[0]?.properties?.comarca as
                string | undefined;
              if (name)
                openComarcaPopup(name, [e.lngLat.lng, e.lngLat.lat], map);
            });
            map.on(
              "mouseenter",
              "crm-comarca-badge",
              () => (map.getCanvas().style.cursor = "pointer"),
            );
            map.on(
              "mouseleave",
              "crm-comarca-badge",
              () => (map.getCanvas().style.cursor = ""),
            );
          }
        } catch (err) {
          console.warn("Could not load comarques GeoJSON:", err);
        }

        // Network anchor nodes
        map.addSource("networks", { type: "geojson", data: networkNodesGeo });
        map.addLayer({
          id: "networks-halo",
          type: "circle",
          source: "networks",
          paint: {
            "circle-radius": 22,
            "circle-color": [
              "match",
              ["get", "network"],
              "miceli",
              "#8B5A3C",
              "keras-buti",
              "#6B4EA3",
              "#1d1a16",
            ],
            "circle-opacity": 0.18,
            "circle-stroke-width": 1,
            "circle-stroke-color": [
              "match",
              ["get", "network"],
              "miceli",
              "#8B5A3C",
              "keras-buti",
              "#6B4EA3",
              "#1d1a16",
            ],
            "circle-stroke-opacity": 0.5,
          } as any,
        });
        map.addLayer({
          id: "networks-dot",
          type: "circle",
          source: "networks",
          paint: {
            "circle-radius": 6,
            "circle-color": [
              "match",
              ["get", "network"],
              "miceli",
              "#8B5A3C",
              "keras-buti",
              "#6B4EA3",
              "#1d1a16",
            ],
            "circle-stroke-width": 1.5,
            "circle-stroke-color": "#1d1a16",
          } as any,
        });
        map.addLayer({
          id: "networks-label",
          type: "symbol",
          source: "networks",
          layout: {
            "text-field": ["get", "label"],
            "text-font": ["IBM Plex Mono Regular", "Open Sans Regular"],
            "text-size": 10,
            "text-letter-spacing": 0.1,
            "text-offset": [0, 1.8],
            "text-anchor": "top",
            "text-allow-overlap": true,
            "text-padding": 6,
          },
          paint: {
            "text-color": "#1d1a16",
            "text-halo-color": "#fbf9f3",
            "text-halo-width": 2,
            "text-opacity": 0.85,
          },
        });

        // CRM actor markers (Task 13). Added BEFORE the cohort project layers
        // so it renders underneath them — the cohort stays the primary read of
        // the map and this is context around it. No-ops when the CRM feed is
        // empty, which is the current state (see atlas.astro).
        if (crmGeo.features.length > 0) {
          map.addSource("crm-actors", { type: "geojson", data: crmGeo });
          map.addLayer({
            id: "crm-actors-dot",
            type: "circle",
            source: "crm-actors",
            paint: {
              "circle-radius": [
                "interpolate",
                ["linear"],
                ["zoom"],
                7,
                3,
                12,
                7,
              ] as unknown as number,
              // Colour is baked onto the feature server-side from AGENCY_COLORS.
              "circle-color": [
                "get",
                "color",
              ] as unknown as maplibregl.ColorSpecification,
              "circle-stroke-width": 1,
              "circle-stroke-color": "#fbf9f3",
              "circle-opacity": 0.9,
            },
          });

          map.on("click", "crm-actors-dot", (e) => {
            const f = e.features?.[0];
            if (!f) return;
            if (f.geometry.type !== "Point") return;
            const props = (f.properties ?? {}) as Record<string, string>;
            const coordinates = f.geometry.coordinates as [number, number];
            const tags = String(props.tags ?? "")
              .split("|")
              .map((t) => t.trim())
              .filter(Boolean);
            const html = [
              '<div class="crm-popup">',
              `<p class="crm-popup__name">${escapeHtml(props.name ?? "")}</p>`,
              tags.length
                ? `<ul class="crm-popup__tags">${tags
                    .map((t) => `<li>${escapeHtml(t)}</li>`)
                    .join("")}</ul>`
                : "",
              props.href
                ? `<a class="crm-popup__link" href="${escapeHtml(props.href)}">View in directory &rarr;</a>`
                : "",
              "</div>",
            ].join("");
            new maplibregl.Popup({ closeButton: true, offset: 10 })
              .setLngLat(coordinates.slice() as [number, number])
              .setHTML(html)
              .addTo(map);
          });
          map.on(
            "mouseenter",
            "crm-actors-dot",
            () => (map.getCanvas().style.cursor = "pointer"),
          );
          map.on(
            "mouseleave",
            "crm-actors-dot",
            () => (map.getCanvas().style.cursor = ""),
          );
        }

        // Project markers
        map.addSource("projects", { type: "geojson", data: markersGeo });
        map.addLayer({
          id: "projects-halo",
          type: "circle",
          source: "projects",
          paint: {
            "circle-radius": 14,
            "circle-color": "#fbf9f3",
            "circle-stroke-width": 1,
            "circle-stroke-color": "#1d1a16",
            "circle-stroke-opacity": 0.5,
          },
        });
        map.addLayer({
          id: "projects-dot",
          type: "circle",
          source: "projects",
          paint: {
            "circle-radius": 8,
            "circle-color": [
              "match",
              ["get", "network"],
              "miceli",
              "#8B5A3C",
              "keras-buti",
              "#6B4EA3",
              "#1d1a16",
            ] as unknown as maplibregl.ColorSpecification,
            "circle-stroke-width": 2,
            "circle-stroke-color": "#1d1a16",
          },
        });

        // Active marker emphasis — driven by a filter on the active project id.
        map.addLayer({
          id: "projects-dot-active",
          type: "circle",
          source: "projects",
          filter: ["==", ["get", "id"], ""],
          paint: {
            "circle-radius": 11,
            "circle-color": [
              "match",
              ["get", "network"],
              "miceli",
              "#8B5A3C",
              "keras-buti",
              "#6B4EA3",
              "#1d1a16",
            ] as unknown as maplibregl.ColorSpecification,
            "circle-stroke-width": 3,
            "circle-stroke-color": "#1d1a16",
          },
        });

        // Project name labels — offset below marker, zoom-gated at 8+
        map.addLayer({
          id: "projects-label",
          type: "symbol",
          source: "projects",
          minzoom: 8,
          layout: {
            "text-field": ["get", "name"],
            "text-font": ["IBM Plex Mono Regular", "Open Sans Regular"],
            "text-size": 11,
            "text-letter-spacing": 0.04,
            "text-offset": [0, 1.4],
            "text-anchor": "top",
            "text-allow-overlap": false,
            "text-padding": 6,
          },
          paint: {
            "text-color": "#1d1a16",
            "text-halo-color": "#fbf9f3",
            "text-halo-width": 2,
          },
        });

        // Click + hover handlers
        map.on("click", "projects-dot", (e) => {
          const f = e.features?.[0];
          if (!f) return;
          const id = f.properties?.id as string | undefined;
          if (id) openPopover(id);
        });
        map.on(
          "mouseenter",
          "projects-dot",
          () => (map.getCanvas().style.cursor = "pointer"),
        );
        map.on(
          "mouseleave",
          "projects-dot",
          () => (map.getCanvas().style.cursor = ""),
        );

        // Click anywhere else on the map = close popover
        map.on("click", (e) => {
          const features = map.queryRenderedFeatures(e.point, {
            layers: ["projects-dot"],
          });
          if (features.length === 0) closePopovers();
        });
      });

      function desaturateBaseStyle(m: maplibregl.Map) {
        // Walk through the loaded style, mute color saturation on non-essential layers.
        // Keeps land + water; reduces road weight.
        try {
          const layers = m.getStyle().layers ?? [];
          for (const layer of layers) {
            const id = (layer as { id?: string }).id;
            if (!id) continue;
            // Roads: thin them out
            if (id.startsWith("road") || id.includes("highway")) {
              try {
                m.setPaintProperty(id, "line-opacity", 0.4);
              } catch {
                /* skip */
              }
            }
            // Parks / vegetation: subdue
            if (
              id.includes("park") ||
              id.includes("landuse") ||
              id.includes("forest")
            ) {
              try {
                m.setPaintProperty(id, "fill-opacity", 0.3);
              } catch {
                /* skip */
              }
            }
          }
        } catch {
          // Best-effort; if the style schema differs, just skip.
        }
      }

      function hideOsmPlaceLabels(m: maplibregl.Map) {
        // Hide OSM city/town/village/place labels — we only want comarca + our own project labels.
        try {
          const layers = m.getStyle().layers ?? [];
          for (const layer of layers) {
            if (layer.type !== "symbol") continue;
            const id = (layer as any).id ?? "";
            const sourceLayer: string = (layer as any)["source-layer"] ?? "";
            const looksLikePlace =
              /place|city|town|village|hamlet|country|state|locality|suburb|neighbourhood/i.test(
                id,
              ) || /place|locality/i.test(sourceLayer);
            if (looksLikePlace) {
              try {
                m.setLayoutProperty(id, "visibility" as any, "none");
              } catch {}
            }
          }
        } catch {
          // Best-effort
        }
      }

      // ===== Network filter =====
      function setNetworkFilter(network: string | null) {
        if (!map.getLayer("projects-dot")) return;
        const opacityExpr: any = network
          ? ["case", ["==", ["get", "network"], network], 1, 0.22]
          : 1;
        const haloOpacityExpr: any = network
          ? ["case", ["==", ["get", "network"], network], 1, 0.22]
          : 1;
        map.setPaintProperty(
          "projects-dot",
          "circle-opacity" as any,
          opacityExpr,
        );
        map.setPaintProperty(
          "projects-halo",
          "circle-opacity" as any,
          haloOpacityExpr,
        );
        if (map.getLayer("projects-label")) {
          map.setPaintProperty(
            "projects-label",
            "text-opacity" as any,
            network
              ? ["case", ["==", ["get", "network"], network], 1, 0.25]
              : 1,
          );
        }
      }

      // ===== Active marker filter =====
      function setActiveMarker(id: string | null) {
        if (!map.getLayer("projects-dot-active")) return;
        const filter = id
          ? ([
              "==",
              ["get", "id"],
              id,
            ] as unknown as maplibregl.FilterSpecification)
          : ([
              "==",
              ["get", "id"],
              "",
            ] as unknown as maplibregl.FilterSpecification);
        map.setFilter("projects-dot-active", filter);
      }

      // ===== Navigation =====
      function fitBounds(prov: string) {
        const b = PROVINCE_BOUNDS[prov];
        if (!b) return;
        map.fitBounds(b, {
          padding: { top: 80, right: 80, bottom: 60, left: 80 },
          duration: prefersReducedMotion() ? 0 : 600,
          essential: true,
        });
      }

      // Province chip handlers
      const chips = host.querySelectorAll<HTMLButtonElement>(".prov-chip");
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const prov = chip.dataset.prov;
          if (!prov || !PROVINCE_BOUNDS[prov]) return;
          chips.forEach((c) => c.classList.toggle("active", c === chip));
          fitBounds(prov);
          if (chip.classList.contains("net-chip")) {
            setNetworkFilter(chip.dataset.network ?? null);
          } else {
            setNetworkFilter(null);
          }
        });
      });

      // Zoom button handlers
      host
        .querySelector<HTMLButtonElement>("[data-zoom-in]")
        ?.addEventListener("click", () => {
          map.zoomIn({ duration: prefersReducedMotion() ? 0 : 220 });
        });
      host
        .querySelector<HTMLButtonElement>("[data-zoom-out]")
        ?.addEventListener("click", () => {
          map.zoomOut({ duration: prefersReducedMotion() ? 0 : 220 });
        });
      host
        .querySelector<HTMLButtonElement>("[data-zoom-reset]")
        ?.addEventListener("click", () => {
          chips.forEach((c) =>
            c.classList.toggle("active", c.dataset.prov === "catalunya"),
          );
          fitBounds("catalunya");
          setNetworkFilter(null);
        });

      // ===== POPOVER BEHAVIOR =====
      const popovers = host.querySelectorAll<HTMLElement>("[data-popover-id]");
      const hint = host.querySelector<HTMLElement>(".map-hint");

      function closePopovers() {
        popovers.forEach((p) => (p.hidden = true));
        setActiveMarker(null);
        if (hint) hint.style.opacity = "1";
      }
      function openPopover(id: string) {
        closePopovers();
        const target = host.querySelector<HTMLElement>(
          `[data-popover-id="${id}"]`,
        );
        if (!target) return;
        target.hidden = false;
        setActiveMarker(id);
        if (hint) hint.style.opacity = "0";
      }

      popovers.forEach((p) => {
        const closeBtn = p.querySelector<HTMLButtonElement>(".popover-close");
        closeBtn?.addEventListener("click", () => closePopovers());
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closePopovers();
      });
    });
</script>

