---
import type { Priority } from "../lib/priorities";

interface Props {
  priorities: Priority[];
}

const { priorities } = Astro.props;

const nodes = priorities.map((p, index) => {
  const angle = (index / priorities.length) * 2 * Math.PI - Math.PI / 2;
  const radius = 110;
  return {
    ...p,
    x: 150 + radius * Math.cos(angle),
    y: 150 + radius * Math.sin(angle),
  };
});

const edges = [
  [0, 1],
  [0, 2],
  [0, 3],
  [0, 5],
  [1, 2],
  [1, 3],
  [1, 5],
  [2, 3],
  [2, 4],
  [3, 4],
  [3, 5],
  [4, 5],
];
---

<figure class="interdependence">
  <svg
    viewBox="0 0 300 300"
    class="interdependence__svg"
    role="img"
    aria-label="Interdependence of the six priorities"
  >
    <title>Six priorities as an interdependent system</title>
    {
      edges.map(([a, b]) => (
        <line
          x1={nodes[a].x}
          y1={nodes[a].y}
          x2={nodes[b].x}
          y2={nodes[b].y}
          class="interdependence__edge"
        />
      ))
    }
    {
      nodes.map((node) => (
        <a
          href={`/priorities/${node.slug}/`}
          class="interdependence__node-link"
        >
          <circle
            cx={node.x}
            cy={node.y}
            r="18"
            class="interdependence__node"
            style={`--node-color: ${node.color}`}
          />
          <text
            x={node.x}
            y={node.y}
            class="interdependence__label"
            text-anchor="middle"
            dominant-baseline="middle"
          >
            {node.id.slice(0, 2).toUpperCase()}
          </text>
        </a>
      ))
    }
  </svg>
  <figcaption class="interdependence__caption">
    The six priorities compound. Restore watersheds → food resilience; reduce
    energy demand → less pressure on water; social commons → capacity to act
    across all.
  </figcaption>
</figure>

<style>
  .interdependence {
    margin: 0;
  }
  .interdependence__svg {
    width: 100%;
    max-width: 28rem;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .interdependence__edge {
    stroke: var(--border-default);
    stroke-width: 1;
  }
  .interdependence__node-link {
    text-decoration: none;
  }
  .interdependence__node {
    fill: color-mix(
      in srgb,
      var(--node-color, var(--ink)) 12%,
      var(--surface-1)
    );
    stroke: var(--node-color, var(--ink));
    stroke-width: 1.5;
    transition:
      fill var(--t-fast),
      stroke-width var(--t-fast);
  }
  .interdependence__node-link:hover .interdependence__node {
    fill: color-mix(
      in srgb,
      var(--node-color, var(--ink)) 20%,
      var(--surface-1)
    );
    stroke-width: 2.5;
  }
  .interdependence__label {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
    fill: var(--node-color, var(--ink));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    pointer-events: none;
  }
  .interdependence__caption {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-align: center;
    margin-top: var(--space-4);
    max-width: 45ch;
    margin-left: auto;
    margin-right: auto;
  }
</style>
