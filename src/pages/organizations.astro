---
import Layout from "../components/Layout.astro";
import SourceCrumb from "../components/SourceCrumb.astro";
import OrganicAmbient from "../components/OrganicAmbient.astro";
import { loadSectionConfig, fetchDatabaseRecords } from "../lib/notion";
import {
  normalizeRecord,
  hasCatbis,
  uniqueValues,
  priorityAreaOptions,
  territoryOptions,
  priorityColor,
} from "../lib/crm";
import type { CrmActor } from "../lib/crm";
// Soft banner locally, hard build failure under REQUIRE_NOTION=1 (CI).
import { crmFailure } from "../lib/crm-strict.mjs";
// Shared with the atlas: marker popups link to `#<actorAnchor(name)>` on this
// page, so both sides must derive the anchor from the one helper.
import { actorAnchor, assertUniqueAnchors } from "../lib/atlas-data.mjs";

const sections = loadSectionConfig();
const actorsSection = sections.find((s) => s.id === "actors");

let records: any[] = [];
let error: string | null = null;
if (actorsSection?.database_id) {
  try {
    records = await fetchDatabaseRecords(actorsSection.database_id);
  } catch (e: any) {
    error = crmFailure(e, "actors", import.meta.env.REQUIRE_NOTION);
  }
} else {
  error = "No database_id configured for actors section.";
}

const actors: CrmActor[] = records.filter(hasCatbis).map(normalizeRecord);

// Card ids are `actorAnchor(name)`, and the atlas links to them. Two actors
// with the same name would emit duplicate DOM ids and silently break every
// link to that anchor, so stop the build instead. 121 records, 121 anchors
// today; 15 names are duplicated elsewhere in the CRM.
// `actor-gallery` is the grid container's id; an actor named "Gallery" would
// slug onto it. The JSON payload below uses a non-`actor-` id for the same
// reason, so it needs no entry here.
assertUniqueAnchors(
  actors.map((a) => a.name),
  "the /organizations directory",
  ["actor-gallery"],
);

const activePriorityAreas = priorityAreaOptions.filter((p) =>
  actors.some((a) => a.thirdTags.includes(p)),
);
const activeTerritories = territoryOptions.filter((t) =>
  actors.some((a) => a.area2.includes(t)),
);
const actorRoles = uniqueValues(actors, "actorRoles").filter(Boolean);
const ontologyTags = uniqueValues(actors, "ontologyTags").filter(Boolean);
const themes = uniqueValues(actors, "themes").filter(Boolean);

// The client only filters and searches; it never re-renders a card. So the
// payload carries just the fields the script reads — the five filter facets
// plus the three search fields — instead of the whole record. Dropping the
// unused half (Notion relation id arrays especially, which are 36 chars per
// entry) is most of the weight. Card N corresponds to filterIndex[N].
const filterIndex = actors.map((a) => ({
  name: a.name,
  description: a.description,
  whyItMatters: a.whyItMatters,
  thirdTags: a.thirdTags,
  area2: a.area2,
  actorRoles: a.actorRoles,
  ontologyTags: a.ontologyTags,
  themes: a.themes,
}));

const safeJson = (obj: any) =>
  JSON.stringify(obj)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026");
---

<Layout title="Organizations" current="organizations">
  <SourceCrumb
    container="notion-refi-bcn"
    note="read from the CRM at build time, never written back"
  />
  <header class="hero hero--compact">
    <OrganicAmbient />
    <div class="hero__inner section">
      <p class="eyebrow">Regenerant Catalunya</p>
      <h1 class="display">Organizations</h1>
      <p class="lede">
        Discover regenerative actors, organizations, networks, and initiatives
        across Catalunya. Search by name or filter by priority area, territory,
        role, themes, and ontology tags.
      </p>
    </div>
  </header>

  <section class="section section--wide">
    {
      error && (
        <div class="error-banner">
          <p>
            <strong>Data error:</strong> {error}
          </p>
        </div>
      )
    }

    <div class="filter-panel">
      <div class="filter-panel__header">
        <h2 class="filter-panel__title">Filters</h2>
        <button type="button" class="filter-clear" id="clear-filters"
          >Clear all</button
        >
      </div>

      <div class="filter-search">
        <label class="filter-label" for="search-input">Search by name</label>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder="Type an organization name…"
          autocomplete="off"
        />
      </div>

      <div class="filter-grid">
        <fieldset class="filter-group">
          <legend class="filter-label">Priority area</legend>
          <div class="filter-buttons" id="priority-filters">
            {
              activePriorityAreas.map((tag) => (
                <button
                  type="button"
                  class="filter-btn"
                  data-filter-value={tag}
                  style={`--filter-color: ${priorityColor(tag)}`}
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="filter-group">
          <legend class="filter-label">Actor role</legend>
          <div class="filter-buttons" id="role-filters">
            {
              actorRoles.map((tag) => (
                <button
                  type="button"
                  class="filter-btn"
                  data-filter-value={tag}
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="filter-group filter-group--wide">
          <legend class="filter-label">Territory</legend>
          <div class="checkbox-list" id="territory-filters">
            {
              activeTerritories.map((tag) => (
                <label class="checkbox-item">
                  <input type="checkbox" value={tag} />
                  <span>{tag}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="filter-group filter-group--wide">
          <legend class="filter-label">Ontology tags</legend>
          <div class="checkbox-list" id="ontology-filters">
            {
              ontologyTags.map((tag) => (
                <label class="checkbox-item">
                  <input type="checkbox" value={tag} />
                  <span>{tag}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="filter-group filter-group--wide">
          <legend class="filter-label">Themes</legend>
          <div class="checkbox-list" id="theme-filters">
            {
              themes.map((tag) => (
                <label class="checkbox-item">
                  <input type="checkbox" value={tag} />
                  <span>{tag}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>
    </div>

    <p class="count" id="gallery-count">Loading…</p>

    <div class="actor-grid" id="actor-gallery">
      {
        actors.map((actor) => (
          <article class="actor-card" id={actorAnchor(actor.name)}>
            <div class="actor-card__main">
              <div class="actor-card__header">
                <h3 class="actor-name">{actor.name}</h3>
                {actor.actorType && (
                  <span class="actor-type">{actor.actorType}</span>
                )}
              </div>

              <p class="actor-description">
                {actor.description ||
                  actor.whyItMatters ||
                  "No description available."}
              </p>

              <div class="actor-badges">
                {actor.thirdTags.map((tag) => (
                  <span
                    class="priority-badge"
                    style={`--badge-color: ${priorityColor(tag)}`}
                  >
                    {tag}
                  </span>
                ))}
                {actor.area2.map((area) => (
                  <span class="territory-badge">{area}</span>
                ))}
              </div>

              <div class="actor-actions">
                {actor.website && (
                  <a
                    href={actor.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="actor-link"
                  >
                    Website →
                  </a>
                )}
                <button
                  type="button"
                  class="details-toggle"
                  data-details-toggle
                >
                  Details
                </button>
              </div>
            </div>

            <div class="actor-card__details" hidden>
              {actor.whyItMatters && (
                <div class="detail-block">
                  <h4>Why it matters</h4>
                  <p>{actor.whyItMatters}</p>
                </div>
              )}

              {actor.publicEmail && (
                <div class="detail-block">
                  <h4>Public contact</h4>
                  <a href={`mailto:${actor.publicEmail}`} class="actor-link">
                    {actor.publicEmail}
                  </a>
                </div>
              )}

              {actor.linkedin && (
                <div class="detail-block">
                  <h4>LinkedIn</h4>
                  <a
                    href={actor.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="actor-link"
                  >
                    {actor.linkedin}
                  </a>
                </div>
              )}

              {actor.climateZone && (
                <div class="detail-block">
                  <h4>Climate context</h4>
                  <p>{actor.climateZone}</p>
                </div>
              )}

              {actor.themes.length > 0 && (
                <div class="detail-block">
                  <h4>Themes</h4>
                  <div class="detail-tags">
                    {actor.themes.map((t) => (
                      <span class="detail-tag">{t}</span>
                    ))}
                  </div>
                </div>
              )}

              {actor.ontologyTags.length > 0 && (
                <div class="detail-block">
                  <h4>Ontology tags</h4>
                  <div class="detail-tags">
                    {actor.ontologyTags.map((t) => (
                      <span class="detail-tag">{t}</span>
                    ))}
                  </div>
                </div>
              )}

              {actor.relatedInitiatives.length > 0 && (
                <div class="detail-block">
                  <h4>Related initiatives</h4>
                  <ul>
                    {actor.relatedInitiatives.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {actor.relatedProjects.length > 0 && (
                <div class="detail-block">
                  <h4>Related projects or areas</h4>
                  <ul>
                    {actor.relatedProjects.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {actor.relatedEvents.length > 0 && (
                <div class="detail-block">
                  <h4>Related events</h4>
                  <ul>
                    {actor.relatedEvents.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {actor.relatedResources.length > 0 && (
                <div class="detail-block">
                  <h4>Related resources</h4>
                  <ul>
                    {actor.relatedResources.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <script
      type="application/json"
      id="directory-filter-data"
      is:inline
      set:html={safeJson(filterIndex)}
    />
  </section>

  <script is:inline>
    (function () {
      const cards = Array.from(document.querySelectorAll(".actor-card"));
      // One shared payload rather than a copy per card. Card N corresponds to
      // actors[N] — both come from the same server-side array, in order.
      const actors = JSON.parse(
        document.getElementById("directory-filter-data").textContent,
      );
      const countLabel = document.getElementById("gallery-count");
      const searchInput = document.getElementById("search-input");
      const clearBtn = document.getElementById("clear-filters");

      const filters = {
        thirdTags: [],
        area2: [],
        actorRoles: [],
        ontologyTags: [],
        themes: [],
        search: "",
      };

      function normalize(str) {
        return String(str || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/\p{Diacritic}/gu, "");
      }

      function matches(actor, key, values) {
        if (values.length === 0) return true;
        const actorValues = actor[key] || [];
        return values.some((v) => actorValues.includes(v));
      }

      function matchesSearch(actor) {
        const term = normalize(filters.search).trim();
        if (!term) return true;
        const haystack = normalize(
          [actor.name, actor.description, actor.whyItMatters].join(" "),
        );
        return haystack.includes(term);
      }

      function isVisible(actor) {
        return (
          matchesSearch(actor) &&
          matches(actor, "thirdTags", filters.thirdTags) &&
          matches(actor, "area2", filters.area2) &&
          matches(actor, "actorRoles", filters.actorRoles) &&
          matches(actor, "ontologyTags", filters.ontologyTags) &&
          matches(actor, "themes", filters.themes)
        );
      }

      function updateGallery() {
        let visible = 0;
        for (let i = 0; i < actors.length; i++) {
          const show = isVisible(actors[i]);
          cards[i].classList.toggle("is-hidden", !show);
          if (show) visible++;
        }
        if (countLabel) {
          countLabel.textContent = `Showing ${visible} of ${actors.length} organizations`;
        }
      }

      function bindButtonGroup(containerId, key) {
        document
          .querySelectorAll(`#${containerId} .filter-btn`)
          .forEach((btn) => {
            btn.addEventListener("click", () => {
              const value = btn.dataset.filterValue;
              const active = btn.classList.toggle("active");
              btn.setAttribute("aria-pressed", String(active));
              if (active) {
                filters[key].push(value);
              } else {
                filters[key] = filters[key].filter((v) => v !== value);
              }
              updateGallery();
            });
          });
      }

      function bindCheckboxGroup(containerId, key) {
        document
          .querySelectorAll(`#${containerId} input[type='checkbox']`)
          .forEach((input) => {
            input.addEventListener("change", () => {
              filters[key] = Array.from(
                document.querySelectorAll(
                  `#${containerId} input[type='checkbox']:checked`,
                ),
              ).map((el) => el.value);
              updateGallery();
            });
          });
      }

      bindButtonGroup("priority-filters", "thirdTags");
      bindButtonGroup("role-filters", "actorRoles");
      bindCheckboxGroup("territory-filters", "area2");
      bindCheckboxGroup("ontology-filters", "ontologyTags");
      bindCheckboxGroup("theme-filters", "themes");

      if (searchInput) {
        searchInput.addEventListener("input", () => {
          filters.search = searchInput.value;
          updateGallery();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          filters.thirdTags = [];
          filters.area2 = [];
          filters.actorRoles = [];
          filters.ontologyTags = [];
          filters.themes = [];
          filters.search = "";
          if (searchInput) searchInput.value = "";
          document.querySelectorAll(".filter-btn.active").forEach((btn) => {
            btn.classList.remove("active");
            btn.setAttribute("aria-pressed", "false");
          });
          document
            .querySelectorAll(".checkbox-list input[type='checkbox']")
            .forEach((input) => {
              input.checked = false;
            });
          updateGallery();
        });
      }

      document.querySelectorAll("[data-details-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest(".actor-card");
          const details = card.querySelector(".actor-card__details");
          const hidden = details.hidden;
          details.hidden = !hidden;
          btn.textContent = hidden ? "Hide details" : "Details";
        });
      });

      updateGallery();
    })();
  </script>
</Layout>

<style>
  .hero--compact {
    position: relative;
    padding: var(--space-12) var(--gutter) var(--space-8);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--container-default);
    margin: 0 auto;
  }
  .hero--compact .eyebrow {
    margin-bottom: var(--space-3);
  }
  .hero--compact h1 {
    margin-bottom: var(--space-4);
  }
  .hero--compact .lede {
    max-width: 70ch;
  }

  .filter-panel {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .filter-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .filter-panel__title {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0;
  }
  .filter-clear {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition:
      background-color var(--t-fast),
      border-color var(--t-fast);
  }
  .filter-clear:hover {
    background: var(--surface-2);
    border-color: var(--primary);
  }

  .filter-search {
    margin-bottom: var(--space-5);
  }
  .filter-search .filter-label {
    display: block;
    margin-bottom: var(--space-2);
  }
  .search-input {
    width: 100%;
    max-width: 40rem;
    padding: var(--space-3) var(--space-4);
    font-family: var(--sans);
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--paper);
    border: 1px solid var(--border-subtle);
    outline: none;
    transition: border-color var(--t-fast);
  }
  .search-input:focus {
    border-color: var(--primary);
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .filter-group {
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
  }
  .filter-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }
  .filter-group--wide {
    grid-column: span 1;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter-btn {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition:
      background-color var(--t-fast),
      color var(--t-fast),
      border-color var(--t-fast);
  }
  .filter-btn:hover {
    border-color: var(--ink);
  }
  .filter-btn.active {
    background: color-mix(
      in srgb,
      var(--filter-color, var(--primary)) 14%,
      var(--surface-1)
    );
    color: var(--filter-color, var(--primary));
    border-color: var(--filter-color, var(--primary));
  }

  .checkbox-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-height: 12rem;
    overflow-y: auto;
    padding: var(--space-2);
    background: var(--paper);
    border: 1px solid var(--border-subtle);
  }
  .checkbox-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .checkbox-item input {
    cursor: pointer;
  }

  .count {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-6);
  }

  .actor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28rem, 1fr));
    gap: var(--space-4);
  }

  .actor-card {
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--t-fast);
  }
  .actor-card:hover {
    border-color: var(--ink);
  }
  .actor-card.is-hidden {
    display: none;
  }

  .actor-card__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .actor-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .actor-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .actor-type {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }
  .actor-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .actor-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .priority-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: color-mix(
      in srgb,
      var(--badge-color, var(--ink)) 14%,
      var(--surface-1)
    );
    color: var(--badge-color, var(--ink));
    border: 1px solid var(--badge-color, var(--ink));
  }
  .territory-badge {
    font-family: var(--mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .actor-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }
  .actor-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast);
  }
  .actor-link:hover {
    border-bottom-color: var(--primary);
  }
  .details-toggle {
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    background: var(--surface-2);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition:
      background-color var(--t-fast),
      border-color var(--t-fast);
  }
  .details-toggle:hover {
    background: var(--paper);
    border-color: var(--ink);
  }

  .actor-card__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--border-subtle);
  }
  .actor-card__details[hidden] {
    display: none;
  }
  .detail-block h4 {
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 var(--space-1);
  }
  .detail-block p,
  .detail-block ul {
    font-size: 0.88rem;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.55;
